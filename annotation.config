// ----------------------------------------------------------------------------
// nf-core/sarek annotation-only resource config
// Used by s02_run_sarek_annotation.py (--step annotate, --tools vep).
// Annotation runs on existing VCFs and is independent of WES/WGS.
// ----------------------------------------------------------------------------

singularity {
  pullTimeout = '60m'
  // VEP plugin data (REVEL/CADD/LoF/SpliceAI/Mastermind paths in --vep_custom_args)
  // is passed to VEP as a plain string, so Nextflow's autoMounts cannot detect
  // those paths and bind them into the container. Bind every directory that holds
  // plugin data that is NOT under your $HOME (Singularity mounts $HOME by default).
  // Extend this list to match your paths; drop entries you don't need.
  runOptions = '--bind /home/by215/.vep --bind /home/jww39'
}

process {
  // VEP
  withName: 'NFCORE_SAREK:SAREK:VCF_ANNOTATE_ALL:VCF_ANNOTATE_ENSEMBLVEP:ENSEMBLVEP_VEP' {
    time   = '48h'
    cpus   = 8
    memory = '64 GB'
  }
}
